{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES6",
    "module": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@shared/*": ["shared/*"],
      "@modules/*": ["modules/*"],
      "@modules/auth/*": ["modules/auth/*"],
      "@modules/students/*": ["modules/students/*"],
      "@modules/academics/*": ["modules/academics/*"],
      "@modules/attendance/*": ["modules/attendance/*"],
      "@modules/exams/*": ["modules/exams/*"],
      "@modules/finance/*": ["modules/finance/*"],
      "@modules/payroll/*": ["modules/payroll/*"],
      "@modules/transport/*": ["modules/transport/*"],
      "@modules/hostel/*": ["modules/hostel/*"],
      "@modules/library/*": ["modules/library/*"],
      "@modules/reports/*": ["modules/reports/*"],
      "@modules/notifications/*": ["modules/notifications/*"],
      "@modules/admissions/*": ["modules/admissions/*"],
      "@modules/timetable/*": ["modules/timetable/*"],
      "@modules/homework/*": ["modules/homework/*"],
      "@modules/staff/*": ["modules/staff/*"],
      "@modules/analytics/*": ["modules/analytics/*"],
      "@modules/settings/*": ["modules/settings/*"],
      "@modules/admin/*": ["modules/admin/*"],
      "@modules/communication/*": ["modules/communication/*"],
      "@modules/inventory/*": ["modules/inventory/*"],
      "@modules/certificates/*": ["modules/certificates/*"],
      "@modules/parents/*": ["modules/parents/*"],
      "@modules/fees/*": ["modules/fees/*"],
      "@modules/ai-assistant/*": ["modules/ai-assistant/*"],
      "@modules/integrations/*": ["modules/integrations/*"],
      "@modules/audit/*": ["modules/audit/*"]
    }
  }
}
